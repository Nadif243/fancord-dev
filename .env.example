# Copy this file to .env and fill in DISCORD_TOKEN. Never commit .env.

# Secret: Developer Portal > your dev app > Bot > Reset Token
DISCORD_TOKEN=

# Not secret: Developer Portal > General Information > Application ID
DISCORD_APP_ID=

# Not secret: right-click the channel in Discord (Developer Mode on) > Copy Channel ID
CHANNEL_TEST=

# Optional. Each defaults to CHANNEL_TEST, so in dev everything lands in #bot-test.
# Split them out later (Phase 1: ops, Phase 2: approval).
# CHANNEL_OPS=
# CHANNEL_ANNOUNCE=
# CHANNEL_APPROVAL=
# Where the weekly recap is posted. Defaults to CHANNEL_ANNOUNCE.
# CHANNEL_RECAP=
# Where the Saturday collab reminder is posted. Defaults to CHANNEL_TEST.
# CHANNEL_REMINDER=
#
# Channels and roles can also be changed from Discord, while the bot runs, with /setup (needs Manage Server). What /setup saves beats these lines, and "/setup reset" goes back to them. See SETTINGS_FILE below.

# Optional. Found automatically from CHANNEL_TEST when empty.
# GUILD_ID=

# Optional. How often the heartbeat message is edited (15 or more).
# HEARTBEAT_SECONDS=60

# Secret: Google Cloud Console > APIs & Services > Credentials. Never commit .env.
# Optional: without it the bot runs, but /devcheck says YouTube is not set up.
YOUTUBE_API_KEY=

# Not secret: Yuura's channel ID (starts with UC)
YOUTUBE_CHANNEL_ID=UCrmtSeYObZJNG6OIC7Pw-_A

# Optional. How often the bot checks YouTube (30 or more). Each check costs 3 of the 10,000 free daily quota units, so 120 uses about 2,200 a day.
# YOUTUBE_POLL_SECONDS=120

# Optional roles the bot pings. Not secret: Server Settings > Roles > right-click > Copy Role ID.
# The role must allow "anyone to @mention this role". No ID, no ping.
ROLE_PING_LIVE=
# ROLE_PING_UPCOMING=
# One role for both the waiting room and going live. The two lines above win over it when they are set, so to use this, leave them empty.
# ROLE_PING=
# A different role, pinged for each tweet that is relayed. No ID, no ping.
# ROLE_PING_TWEETS=

# ---- The community's own YouTube channel ----------------------------------
# Announced like hers (waiting room, live, ended) and its new uploads too, but nothing else: no weekly recap, no collab partners. Needs YOUTUBE_API_KEY.
# Both lines go together; leave them empty to keep this off.
# COMMUNITY_YOUTUBE_CHANNEL_ID=
# COMMUNITY_NAME=
# Where its messages go. Empty: the announcement channel, next to hers.
# CHANNEL_COMMUNITY=
# A role of its own for its pings. Empty: the same roles as hers (ROLE_PING_*, or what /setup saved), for waiting rooms, live streams and new videos alike.
# ROLE_PING_COMMUNITY=
# How often it is checked (30 or more). Each check costs 3 of the 10,000 free daily quota units, on top of hers: 300 uses about 860 a day.
# COMMUNITY_POLL_SECONDS=300
# What it announced (kept apart from hers).
# COMMUNITY_FILE=data/community.json

# Optional. Where the bot records every stream it sees, for the weekly recap.
# HISTORY_FILE=data/history.json

# Optional. The collab partner list the weekly recap uses (a CSV you can edit in Excel). Without the file the recap simply has no collab line.
# PARTNERS_FILE=partners.csv

# Optional. What /setup saved (channels and roles). Delete it to go back to this file.
# SETTINGS_FILE=data/settings.json

# Optional. Where the bot keeps the collab partners people tag with /collab.
# COLLAB_FILE=data/collabs.json
#
# The "who is meant?" questions about nicknames two partners share (aya, miu).
# WHICH_FILE=data/which.json
#
# The role panel: its groups, roles and emoji (edited with /rolepanel).
# ROLES_FILE=data/roles.json
#
# How many times each person has used /rodok on each other person.
# RODOK_FILE=data/rodok.json

# ---- X (Twitter): relays her posts into a channel -------------------------
# Secret: developer.x.com > your app > Keys and tokens > Bearer Token.
# Never paste it in chat and never commit it. Without it the relay is off.
X_BEARER_TOKEN=

# Optional. Where her posts go. Defaults to CHANNEL_ANNOUNCE.
# CHANNEL_TWEETS=1566483767894216895

# Optional. Her handle, without the @.
# X_USERNAME=YozakuraYuura

# Optional. How often X is checked (60 or more). X bills per post read, and a check that finds nothing new returns nothing.
# X_POLL_SECONDS=300

# Optional. Which kinds of posts are relayed: post, reply, quote, repost.
# X_RELAY_TYPES=post,reply,quote,repost

# Optional. The relay pauses for the rest of the month after this many billed reads (about $0.005 each, so 250 is about $1.25). Ops is warned at 80%.
# X_MONTHLY_READ_CAP=250

# Optional. How a post is shown: "card" (author, text, pictures or video, the translation, numbers) or "link" (a plain link that Discord previews itself, like before). A post the card cannot show goes out as a link either way.
# TWEET_STYLE=card

# ---- Translation of Japanese posts --------------------------------------
# A post written in Japanese gets a machine translation in its card; posts in Indonesian or English are left alone. Needs both lines below. Secret: the key from Google AI Studio. Never paste it in chat and never commit it. Without it nothing is translated.
GEMINI_API_KEY=
# The model to ask.
GEMINI_MODEL=
# Optional. The language to translate into, named in English.
# TRANSLATE_TO=Indonesian

# --- Collabs on other channels -------------------------------------------
# Videos linked in her X posts (and links people send with /collablink) are looked up on YouTube and posted in CHANNEL_APPROVAL with Confirm / Ignore buttons. Needs YOUTUBE_API_KEY and YOUTUBE_CHANNEL_ID.
#
# The role whose members may press the buttons (a role ID). Strongly recommended. Left empty, only members with Manage Server or Administrator can.
# ROLE_COLLAB_REVIEW=
#
# Words that show a video is about her (checked in title and description).
# COLLAB_MENTION_WORDS=yuura,yozakura
#
# YouTube channel IDs (UC...) whose videos are never shown, comma-separated.
# COLLAB_IGNORE_CHANNELS=
#
# OUTSIDE_FILE=data/outside.json
#
# --- Fan channel for collab links ---
# A channel where fans paste YouTube links (handled at once) or X links (the bot reads the post once, for the YouTube link inside it). Needs the Message Content intent switched on in the Developer Portal first:
#   discord.com/developers -> your application -> Bot -> Privileged Gateway
#   Intents -> Message Content Intent -> on -> Save.
# Without that switch the bot cannot connect, so turn it on BEFORE setting this.
# The bot also needs View Channel, Send Messages and Add Reactions there.
# CHANNEL_COLLAB_LINKS=
#
# X posts read per month for links fans send; each is one billed read (about $0.005). 0 turns reading X links off (YouTube links still work).
# X_FAN_LOOKUP_CAP=20
